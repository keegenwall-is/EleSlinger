{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "4cd2ee2fc9fb4afda80ba236f2320d87",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "MainLight (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 354.0000305175781,
            "y": 149.99996948242188,
            "width": 221.00003051757813,
            "height": 141.99996948242188
        }
    },
    "m_Slots": [
        {
            "m_Id": "c0227110a4494544bddd8e5cfb139a38"
        },
        {
            "m_Id": "0b6fdf365a444e0f9a801ff2803455b8"
        },
        {
            "m_Id": "3b690135e41f4b958c34daf7d2dce89a"
        },
        {
            "m_Id": "183ed8819f0247d5ac71a16a3cc8e2b7"
        },
        {
            "m_Id": "402818262cbe4bad894d98c53d0b08bf"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "MainLight",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#ifdef SHADERGRAPH_PREVIEW\n    Direction = half3(0.5, 0.5, 0);\n    Color = half3(1, 1, 1);\n    ShadowAtten = 1.0;\n#else\n    // ----------------------------------------------------\n    // BRIGHTNESS & AMBIENT CONTROLS\n    // ----------------------------------------------------\n    half minShadow = 0.4h; \n\n    // ----------------------------------------------------\n    // 1. MAIN LIGHT MULTI-TIERED SHADING\n    // ----------------------------------------------------\n    #if defined(_MAIN_LIGHT_SHADOWS_SCREEN)\n        half4 clipPos = TransformWorldToHClip(WorldPos);\n        half4 shadowCoord = ComputeScreenPos(clipPos);\n    #else\n        half4 shadowCoord = TransformWorldToShadowCoord(WorldPos);\n    #endif\n\n    Light mainLight = GetMainLight(shadowCoord);\n    Direction = mainLight.direction;\n    \n    half NdotL = saturate(dot(Normal, mainLight.direction));\n    half mainLightAtten = NdotL * mainLight.shadowAttenuation;\n    \n    half mainLightCel;\n    if (mainLightAtten > 0.97h)       mainLightCel = 1.0h;   \n    else if (mainLightAtten > 0.5h)   mainLightCel = 0.85h;  \n    else if (mainLightAtten > 0.15h)  mainLightCel = 0.6h;   \n    else                              mainLightCel = minShadow; \n\n    Color = mainLight.color * mainLightCel;\n    ShadowAtten = mainLight.shadowAttenuation;\n\n    // ----------------------------------------------------\n    // 2. ADDITIONAL LIGHTS SHADING (Safe URP Lit Loop)\n    // ----------------------------------------------------\n    #if defined(_ADDITIONAL_LIGHTS)\n        int pixelLightCount = GetAdditionalLightsCount();\n        for (int i = 0; i < pixelLightCount; ++i)\n        {\n            Light addLight = GetAdditionalLight(i, WorldPos, 1.0h);\n            half addNdotL = saturate(dot(Normal, addLight.direction));\n            \n            half insideConeMask = addLight.distanceAttenuation > 0.0001h ? 1.0h : 0.0h;\n            half lightFactor = addNdotL * insideConeMask * addLight.shadowAttenuation;\n            \n            half addLightCel;\n            if (lightFactor > 0.97h)       addLightCel = 1.0h;\n            else if (lightFactor > 0.5h)   addLightCel = 0.85h;\n            else if (lightFactor > 0.15h)  addLightCel = 0.6h;\n            else                           addLightCel = 0.0h; \n\n            half3 flashlightTint = min(addLight.color, 1.2h) * addLightCel;\n            Color += flashlightTint;\n\n            if (addNdotL > 0.0h)\n            {\n                ShadowAtten *= addLight.shadowAttenuation;\n            }\n        }\n    #endif\n\n    Color = max(Color, mainLight.color * minShadow);\n#endif\n"
}

